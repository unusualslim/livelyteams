<%
  def nav_active?(path)
    request.path == path || request.path.start_with?(path + "/") ? "active" : ""
  end
%>

<!-- Mobile top bar -->
<div class="sidebar-topbar d-lg-none">
  <button class="sidebar-toggle-btn" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas" aria-controls="sidebarOffcanvas">
    <i class="bi bi-list"></i>
  </button>
  <span class="sidebar-topbar-brand">Lively Teams</span>
</div>

<!-- Desktop sidebar -->
<aside class="app-sidebar d-none d-lg-flex flex-column">
  <%= render 'shared/sidebar_content' %>
</aside>

<!-- Mobile offcanvas sidebar -->
<div class="offcanvas offcanvas-start app-sidebar-offcanvas" tabindex="-1" id="sidebarOffcanvas" aria-labelledby="sidebarOffcanvasLabel">
  <div class="offcanvas-header border-bottom border-secondary pb-3">
    <span class="sidebar-brand" id="sidebarOffcanvasLabel">Lively Teams</span>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body p-0 d-flex flex-column">
    <%= render 'shared/sidebar_content' %>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const input = document.querySelector("[data-autocomplete-target='input']");
    const suggestionsContainer = document.getElementById("autocomplete-suggestions");

    if (!input || !suggestionsContainer) return;

    const isInternal = <%= current_user&.internal? ? "true" : "false" %>;

    document.addEventListener("click", function(e) {
      if (!e.target.closest("#autocomplete-suggestions") && e.target !== input) {
        suggestionsContainer.style.display = "none";
      }
    });

    input.addEventListener("input", function() {
      const query = input.value.trim();
      if (query.length < 2) {
        suggestionsContainer.style.display = "none";
        return;
      }

      fetch(`/search.json?q=${encodeURIComponent(query)}`)
        .then(r => r.json())
        .then(data => renderSuggestions(data))
        .catch(() => { suggestionsContainer.style.display = "none"; });
    });

    function renderSuggestions(data) {
      suggestionsContainer.innerHTML = "";
      const cases = data.cases || [];
      const locations = isInternal ? (data.locations || []) : [];

      if (cases.length === 0 && locations.length === 0) {
        suggestionsContainer.style.display = "none";
        return;
      }

      const items = [];
      if (cases.length > 0) {
        items.push(`<li class="sidebar-autocomplete-header">Cases</li>`);
        cases.forEach(item => {
          items.push(`<li class="sidebar-autocomplete-item" data-url="${item.url}">${item.name}</li>`);
        });
      }
      if (locations.length > 0) {
        items.push(`<li class="sidebar-autocomplete-header">Locations</li>`);
        locations.forEach(item => {
          items.push(`<li class="sidebar-autocomplete-item" data-url="${item.url}">${item.name}</li>`);
        });
      }

      suggestionsContainer.innerHTML = items.join("");
      suggestionsContainer.style.display = "block";

      suggestionsContainer.querySelectorAll(".sidebar-autocomplete-item").forEach(item => {
        item.addEventListener("click", function() {
          if (this.dataset.url) window.location = this.dataset.url;
        });
      });
    }
  });
</script>
