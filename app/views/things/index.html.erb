
<%= link_to '+', new_thing_path, :class => "btn btn-primary" %>

<div class="table-responsive">
<table class="table table-hover">
  <thead>
    <tr>
      <th scope="col">Name</th>
      <th scope="col" class="d-none d-md-table-cell">Date Modified</th>
      <th scope="col" class="d-none d-md-table-cell">Size</th>
      <th scope="col" class="d-none d-md-table-cell">Type</th>
      <th scope="col" colspan="2"></th>
    </tr>
  </thead>
  <tbody>
    <% @things.each do |thing| %>
    <% thing.files.each do |f| %>
      <tr>
        <td><%= link_to f.filename, url_for(f) %></td>
        <td class="d-none d-md-table-cell"><%= thing.updated_at.strftime("%b %e, %Y at %l:%M %P") %></td>
        <td class="d-none d-md-table-cell"><%= number_to_human_size(f.byte_size) %></td>
        <td class="d-none d-md-table-cell"><%= f.content_type %></td>
        <td><%# link_to 'Rename', edit_thing_path(thing) %></td>
        <td><%= link_to 'Download', rails_blob_path(f, disposition: "attachment") %></td>
        <td><%# link_to 'X', rails_blob_path(f), method: :delete, data: {confirm: 'Are you sure?'}, :class => "btn btn-danger btn-sm" %></td>
      </tr>
    <% end %>
    <% end %>
  </tbody>
</table>
</div>

