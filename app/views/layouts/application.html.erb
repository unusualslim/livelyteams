<!doctype html>
<html lang="en">
  <head>
    <title>Lively Teams</title>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" media="print" onload="this.media='all'">
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.bubble.css" rel="stylesheet" media="print" onload="this.media='all'">
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    <%= javascript_include_tag 'tinymce_init', "data-turbo-track": "reload", defer: true %>
    <style media="print">
      /* Hide all navigation chrome */
      .app-sidebar,
      .app-sidebar-offcanvas,
      .sidebar-topbar,
      .d-print-none {
        display: none !important;
      }

      /* Full-width content, white background */
      body.app-layout {
        display: block !important;
        background: #fff !important;
        padding: 0 !important;
        margin: 0 !important;
      }

      .app-main {
        padding: 0.5rem !important;
        width: 100% !important;
      }

      /* Clean up colors */
      body { color: #000 !important; font-size: 11pt !important; }
      a { color: #000 !important; text-decoration: none !important; }

      /* Badges: border instead of colored background */
      .badge {
        border: 1px solid #555 !important;
        background: #fff !important;
        color: #000 !important;
      }

      /* Comment boxes */
      .alert-primary {
        background: #fff !important;
        border: 1px solid #ccc !important;
        color: #000 !important;
      }

      /* Keep images from overflowing */
      img { max-width: 100% !important; }

      /* Avoid breaking cards/comments across pages */
      .card, .alert { break-inside: avoid !important; }
      h2 { break-after: avoid !important; }
    </style>
  </head>

  <body class="app-layout">
    <%= render 'shared/navigation' %>
    <main class="app-main">
      <%= yield %>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.min.js" defer></script>
  </body>
</html>
