<ul class="nav nav-pills flex-wrap gap-1 mb-3">
  <li class="nav-item"><%= link_to 'Open Cases', cases_path, class: "nav-link active" %></li>
  <li class="nav-item"><%= link_to 'Inspectable', inspectable_cases_path, class: "nav-link" %></li>
  <li class="nav-item"><%= link_to 'Billable', billable_cases_path, class: "nav-link" %></li>
  <li class="nav-item"><%= link_to 'Closed', closed_cases_path, class: "nav-link" %></li>
</ul>

<h2 class="mb-3">Open Cases (<%= @open_cases.count %>)</h2>

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
  <%= link_to 'New Case', new_case_path, class: "btn btn-success" %>
  <input class="table_search form-control" style="max-width: 260px;" type="text" placeholder="Search...">
</div>
<%# Mobile card layout (hidden on md+) %>
<div class="d-md-none searchable">
  <% @open_cases.each do |c| %>
    <% card_class = case c.severity.severity
         when "Urgent" then "border-danger"
         when "Low"    then "border-secondary"
         else               "border-light"
       end %>
    <div class="card mb-2 <%= card_class %> border-2">
      <div class="card-body py-2 px-3">
        <%# Header row: case # + status indicator %>
        <div class="d-flex justify-content-between align-items-center mb-1">
          <span class="fw-bold"><%= link_to "Case ##{c.id}", case_path(c) %></span>
          <span>
            <% case c.status.status
               when 'In progress' %>
              <span class="spinner-border spinner-border-sm text-primary"></span>
              <small class="text-muted ms-1">In Progress</small>
            <% when 'Complete: Billable' %>
              <span class="badge bg-success"><%= c.status.status %></span>
            <% else %>
              <small class="text-muted"><%= c.status.status %></small>
            <% end %>
          </span>
        </div>
        <%# Subject %>
        <div class="mb-1"><%= c.subject %></div>
        <%# Meta row: assigned + date %>
        <div class="d-flex flex-wrap gap-3 mb-2">
          <small class="text-muted">
            <strong>Assigned:</strong>
            <% if c.assigned_to.present? %>
              <% if c.assigned_to.first_name.blank? %>
                <%= c.assigned_to.email %>
              <% else %>
                <%= "#{c.assigned_to.first_name} #{c.assigned_to.last_name}" %>
              <% end %>
            <% else %>
              Unassigned
            <% end %>
          </small>
          <small class="text-muted">
            <strong>Created:</strong> <%= c.created_at.strftime("%b %d, %Y") %>
          </small>
        </div>
        <%# Action buttons %>
        <div class="d-flex flex-wrap gap-2">
          <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#cardLocations<%= c.id %>">
            <%= c.case_locations.first.location.name %> (<%= c.case_locations.count %>)
          </button>
          <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#cardComments<%= c.id %>">
            Comments (<%= c.case_comments.count %>)
          </button>
          <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#cardAttachments<%= c.id %>">
            Attachments (<%= c.files.count %>)
          </button>
        </div>
        <%# Collapsible sections %>
        <div id="cardLocations<%= c.id %>" class="collapse mt-2 p-2 bg-dark rounded">
          <% c.case_locations.each do |tl| %>
            <%= link_to "#{tl.location.name} (#{tl.location.city})", location_path(tl.location), class: "btn btn-sm btn-outline-light me-1 mb-1" %>
          <% end %>
        </div>
        <div id="cardComments<%= c.id %>" class="collapse mt-2 p-2 bg-dark rounded text-white">
          <%= render c.case_comments %>
          <%= form_with(model: [c, c.case_comments.build]) do |f| %>
            <div class="form-group mb-2">
              <%= f.text_area :body, class: "form-control", rows: 2 %>
            </div>
            <%= f.hidden_field :user_id, value: current_user.id %>
            <%= f.submit 'Add Comment', class: "btn btn-sm btn-primary" %>
          <% end %>
        </div>
        <div id="cardAttachments<%= c.id %>" class="collapse mt-2 p-2 bg-dark rounded text-white">
          <% c.files.each do |f| %>
            <%= link_to f.filename, url_for(f) %><br>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<%# Desktop table layout (hidden below md) %>
<div class="table-responsive table-full-bleed d-none d-md-block">
<table id="cases" class="table align-middle text-center">
  <thead>
    <tr class="text-center">
      <th scope="col" colspan="1"></th>
      <th scope="col">Case No.</th>
      <th scope="col">Subject</th>
      <th scope="col">Assigned To</th>
      <th scope="col">Created On</th>
      <th scope="col">Location</th>
      <th scope="col" colspan="1"></th>
      <th scope="col" colspan="1"></th>
    </tr>
  </thead>

  <tbody class="searchable">
  <% @open_cases.each do |c| %>
  <% case c.severity.severity
    when "Urgent" %>
      <tr scope="row" class="table-danger">
    <% when "Low" %>
      <tr scope="row" class="table-secondary">
    <% else %>
      <tr scope="row" class="table-white">
  <% end %>
    <td>
      <% case c.status.status
         when 'In progress' %>
          <span class="spinner-border spinner-border-sm"></span>
        <% when 'Complete: Billable' %>
          <span class="badge badge-success"><%= c.status.status unless c.status.blank? %></span>
      <% end %>
    </td>
    <td><%= link_to c.id, case_path(c) %></td>
    <td><%= c.subject %></td>
    <td>
      <% if c.assigned_to.present? %>
        <% if c.assigned_to.first_name.blank? %>
          <%= c.assigned_to.email %>
        <% else %>
          <%= "#{c.assigned_to.first_name} #{c.assigned_to.last_name}" %>
        <% end %>
      <% else %>
        <span class="text-muted">Unassigned</span>
      <% end %>
    </td>
    <td><small class="text-muted"><%= c.created_at.strftime("%b %d, %Y") %></small></td>
    <td><button class="btn btn-outline-primary btn-truncate" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLocations<%= c.id %>" aria-expanded="false" aria-controls="collapseLocations<%= c.id %>">
          <%= c.case_locations.first.location.name %> (<%= c.case_locations.count %>)
        </button>
    </td>
    <td><button class="btn btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseComments<%= c.id %>" aria-expanded="false" aria-controls="collapseComments<%= c.id %>">
          Comments (<%= c.case_comments.count %>)
        </button>
     </td>
     <td><button class="btn btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAttachments<%= c.id %>" aria-expanded="false" aria-controls="collapseAttachments<%= c.id %>">
          Attachments (<%= c.files.count %>)
         </button>
     </td>
   </tr>
   <tr>
     <td id="collapseLocations<%= c.id %>" class="collapse bg-dark text-white" colspan="8">
       <% c.case_locations.each do |tl| %>
         <%= link_to "#{tl.location.name} (#{tl.location.city})", location_path(tl.location), :class => "btn btn-outline-primary" %>
       <% end %>
     </td>
   </tr>
   <tr>
     <td class="collapse bg-dark text-white" colspan="8" id="collapseComments<%= c.id %>"><%= render c.case_comments %>
          <%= form_with(model: [ c, c.case_comments.build ]) do |f| %>
          <div class="form-group">
            <%= f.text_area :body, :class => "form-control", :rows => 2, :cols => 1 %>
          </div>
            <%= f.hidden_field :user_id, value: current_user.id %>
          <p>
            <%= f.submit 'Add Comment', class: "btn btn-primary" %>
          </p>
          <% end %>
     </td>
   </tr>
   <tr>
     <td class="collapse bg-dark text-white" colspan="8" id="collapseAttachments<%= c.id %>">
       <% c.files.each do |f| %>
         <%= link_to f.filename, url_for(f) %><br>
       <% end %>
     </td>
   </tr>

  <% end %>
  </tbody>
</table>
</div>

<script>
$(document).on('click', '#show-open-cases-link', function () {
  $.ajax({
    url: '/cases/open_cases_count', // Ensure this matches your route
    method: 'GET',
    dataType: 'json',
    success: function (data) {
      let resultsHtml = '<ul>';
      if (data.length > 0) {
        data.forEach(function (user) {
          resultsHtml += `<li>${user.first_name} ${user.last_name}: ${user.open_cases_count} open case(s)</li>`;
        });
      } else {
        resultsHtml = '<p>No users with open cases found.</p>';
      }
      resultsHtml += '</ul>';
      $('#open-cases-count').html(resultsHtml).show(); // Make sure the div is visible
    },
    error: function () {
      $('#open-cases-count').html('<p>An error occurred while fetching open cases count.</p>').show();
    }
  });
});

</script>