<template id="custom-location-template">
  <div class="custom-location-entry border rounded p-2 mb-2">
    <input type="hidden" name="REPLACE_NAME[case_custom_locations_attributes][REPLACE_INDEX][id]" value="">
    <input type="hidden" name="REPLACE_NAME[case_custom_locations_attributes][REPLACE_INDEX][_destroy]" value="false" class="destroy-flag">
    <div class="row g-2">
      <div class="col-md-6">
        <input type="text" name="REPLACE_NAME[case_custom_locations_attributes][REPLACE_INDEX][name]" placeholder="Location name" class="form-control form-control-sm">
      </div>
      <div class="col-md-6">
        <input type="text" name="REPLACE_NAME[case_custom_locations_attributes][REPLACE_INDEX][address1]" placeholder="Address line 1" class="form-control form-control-sm">
      </div>
      <div class="col-md-6">
        <input type="text" name="REPLACE_NAME[case_custom_locations_attributes][REPLACE_INDEX][address2]" placeholder="Address line 2" class="form-control form-control-sm">
      </div>
      <div class="col-md-4">
        <input type="text" name="REPLACE_NAME[case_custom_locations_attributes][REPLACE_INDEX][city]" placeholder="City" class="form-control form-control-sm">
      </div>
      <div class="col-md-2">
        <input type="text" name="REPLACE_NAME[case_custom_locations_attributes][REPLACE_INDEX][state]" placeholder="State" class="form-control form-control-sm">
      </div>
      <div class="col-md-2">
        <input type="text" name="REPLACE_NAME[case_custom_locations_attributes][REPLACE_INDEX][zip]" placeholder="Zip" class="form-control form-control-sm">
      </div>
      <div class="col-auto d-flex align-items-start">
        <button type="button" class="btn btn-outline-danger btn-sm remove-custom-location">Remove</button>
      </div>
    </div>
  </div>
</template>

<%= form_for @case do |form| %>
  <% if @case.errors.any? %>
    <div id="error_explanation">
      <h2>
        <%= pluralize(@case.errors.count, "error") %> prohibited
        this Case from being saved:
      </h2>
      <ul>
        <% @case.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
   <div class="form-group">
     <%= form.submit "Save", :class => "btn btn-success" %>
   </div>

   <div class="form-group">
    <%= form.label :subject %>
    <%= form.text_field :subject, {required: true, class: "form-control"} %>
   </div>
   <div class="form-group">
     <%= form.label "Locations" %>
     <%= form.collection_select :location_ids, Location.order(:name), :id, :name,{:prompt => false}, {:multiple => true, :size => 10, class: "form-control tom-select-multi" } %>
   </div>
   <div class="form-group">
     <label>One-time Locations</label>
     <div id="custom-locations-container">
       <%= form.fields_for :case_custom_locations do |cl_form| %>
         <%= render 'cases/custom_location_fields', f: cl_form %>
       <% end %>
     </div>
     <button type="button" class="btn btn-outline-secondary btn-sm mt-1" id="add-custom-location">+ Add one-time location</button>
   </div>
   <div class="form-group">
     <%= form.label :severity %>
     <%= form.collection_select :severity_id, Severity.all, :id, :severity, {:prompt => false}, {class: "form-control"} %>
   </div>
   <div class="form-group">
    <%= form.label :status %>
    <%= form.collection_select :status_id, Status.all, :id, :status, {:prompt => false}, {class: "form-control"} %>
  </div>
  <div class="form-group">
    <%= form.label :description %>
    <%= form.text_area :description, class: "form-control" %>
  </div>
  <div class="form-group">
    <%= form.label :attachments %>
    <%= form.file_field :files, {multiple: true, class: "form-control"} %>
  </div>
  <div class="form-group">
    <%= form.label :requested_by %>
    <%= form.collection_select :requested_by_id, User.all, :id, :full_name, {:prompt => false}, {class: "form-control"} %>
  </div>
  <div class="form-group">
    <%= form.label :assigned_to %>
    <%= form.collection_select :assigned_to_id, User.all, :id, :full_name, {:prompt => false}, {class: "form-control"} %>
  </div>
  <div class="form-group">
     <%= form.label "Followed by" %>
     <%= form.collection_select :user_ids, User.order(:email), :id, :full_name,{:prompt => false}, {:multiple => true, :size => 10, :required => false, class: "form-control" } %>
  </div>

<% end %>

<script>
document.addEventListener("turbo:load", function() {
  const container = document.getElementById("custom-locations-container");
  const addBtn = document.getElementById("add-custom-location");
  if (!container || !addBtn) return;

  let index = Date.now();

  addBtn.addEventListener("click", function() {
    const tmpl = document.getElementById("custom-location-template");
    const html = tmpl.innerHTML
      .replace(/REPLACE_NAME/g, "case")
      .replace(/REPLACE_INDEX/g, index++);
    const wrapper = document.createElement("div");
    wrapper.innerHTML = html;
    container.appendChild(wrapper.firstElementChild);
  });

  container.addEventListener("click", function(e) {
    const btn = e.target.closest(".remove-custom-location");
    if (!btn) return;
    const entry = btn.closest(".custom-location-entry");
    const idField = entry.querySelector('input[name*="[id]"]');
    const destroyFlag = entry.querySelector(".destroy-flag");
    if (idField && idField.value) {
      destroyFlag.value = "1";
      entry.style.display = "none";
    } else {
      entry.remove();
    }
  });
});
</script>
