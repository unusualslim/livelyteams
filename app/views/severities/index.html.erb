<h1>Severity</h1>
<%= link_to 'New Severity', new_severity_path %>

<div class="table-responsive">
<table class="table table-striped">
  <thead>
    <tr>
      <th>Severity</th>
      <th>Description</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
  <% @severities.each do |severity| %>
    <tr>
      <td><%= severity.severity %></td>
      <td><%= severity.description %></td>
      <td><%= link_to 'edit', edit_severity_path(severity) %></td>
    </tr>
  <% end %>
  </tbody>
</table>
</div>


