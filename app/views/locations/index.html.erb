<%= link_to '+', new_location_path, :class => "btn btn-primary" %>
<input type="text" class="table_search form-control mb-2" placeholder="Search locations...">
<div class="table-responsive">
<table class="table table-striped">
   <thead>
   <tr>
    <th scope="col">Name</th>
    <th scope="col">Short Name </th>
    <th scope="col">Phone</th>
    <th scope="col">Notes</th>
    <th scope="col" colspan="2"></th>
  </tr>
  <thead>

  <tbody class="searchable">
  <% @locations.each do |location| %>
    <tr scope="row">
      <td><%= link_to location.name, location_path(location) %></td>
      <td><%= location.short_name %></td>
      <td><%= link_to location.phone, "tel:#{location.phone}"  %></td>
      <td class="code" id="code" style="overflow: scroll; width: auto;"><%= location.note %></td>
      <td><%= link_to 'edit', edit_location_path(location) %></td>
      <td><%= link_to 'X', location_path(location.id), data: {turbo_method: :delete, turbo_confirm: 'Are you sure?'}, :class => "btn btn-danger" %></td>
    </tr>

  <% end %>
  </tbody>
</table>
</div>


